# =============================================================
# SmartCV — Environment Variables Template
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=smart_cv_dev

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_strong_password

# ── Rails ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=change_me_generate_with_openssl_rand_hex_64
RAILS_ENV=development

# ── AI / OpenAI ───────────────────────────────────────────────
# Required for CV generation, gap analysis, and semantic search.
OPENAI_API_KEY=sk-...

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ── Frontend (browser-side, must use localhost) ───────────────
# Used to encrypt API keys stored in the browser's localStorage.
# Generate with: openssl rand -hex 32
NEXT_PUBLIC_VAULT_SECRET=change_me_generate_with_openssl_rand_hex_32
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000/cable
NEXT_PUBLIC_AI_URL=http://localhost:8000
